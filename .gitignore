# Sensitive files (do NOT commit)
cookies.txt
*.env
# Cookie/secret dumps from manual debugging — NEVER commit these.
# Credentials belong in environment variables (or the user's local MCP
# config, which lives outside this repo), never in tracked files.
*cookie*.txt
*.cookies
secrets/
*_secrets.*
local_config.*
mcp.json
opencode.json

